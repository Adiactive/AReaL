FROM quay.io/ascend/cann:9.2.1-a3-ubuntu22.04-py3.12

ARG CANN_VERSION=9.2.1
ARG MEGATRON_BRANCH=core_r0.18.0
ARG MEGATRON_COMMIT=dc0ee41ada177d4c74ba46bb501bba5967264815
ARG MINDSPEED_BRANCH=26.2.0_core_r0.18.0
ARG MINDSPEED_COMMIT=bc6a7d793c1a920ff82d5867b3ac32cb6cd5493b
ARG MEGATRON_ADAPTOR_BRANCH=26.2.0_core_r0.18.0
ARG MEGATRON_ADAPTOR_COMMIT=9a2dbe20d92b14dde5522abd98b5b555b78b10a2
ARG TRANSFORMER_ENGINE_NPU_BRANCH=26.2.0_release_v2.17
ARG TRANSFORMER_ENGINE_NPU_COMMIT=7a5e08351d7c0c7bc00a3d4f2c0c6dec4c8999e6
ARG MEGATRON_BRIDGE_TAG=v0.5.1
ARG MEGATRON_BRIDGE_COMMIT=5cb3444c43f7499cf3872b2d46870cf8bc2e00ce
ARG VLLM_TAG=v0.30.0
ARG VLLM_ASCEND_BRANCH=releases/v0.30.0
ARG VLLM_ASCEND_COMMIT=32c31d8ad4d7a41c226f3bcb56314088f5367140
# Upstream v0.3.14.rc1 artifacts report package version 0.3.13.
ARG MOONCAKE_VERSION=0.3.13
ARG MOONCAKE_OBS_PREFIX=https://mindie.obs.cn-north-4.myhuaweicloud.com/buildtools/docker_images_tools/Mooncake/v0.3.14.rc1
ARG TRITON_ASCEND_PACKAGE_VERSION=3.6.0.post2
ARG FLA_VERSION=26.9.1
ARG FLA_RELEASE_TAG=v26.9.1-release
ARG ASCEND_INSTALL_PATH=/usr/local/Ascend
ARG SOC_VERSION=ascend910_9391

# System build deps (the clean CANN base ships none) + pip/uv bootstrap.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        gcc g++ cmake libnuma-dev wget git curl jq vim tmux build-essential gawk clang-15 \
        protobuf-compiler libprotobuf-dev numactl libibverbs-dev libjemalloc2 libhiredis-dev && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-15 20 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-15 20 && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    python3 -m pip install -U pip "setuptools>=80,<81" uv && \
    python3 -m pip cache purge

# Exact-token generation transport for the pinned vLLM release; see
# patches/README.md for provenance and deletion conditions.
COPY patches/vllm-exact-token-validation.patch /areal-workspace/patches/

# Install vLLM + vllm-ascend with the CANN 9.2 / MindSpeed 26.2 runtime.
# Keep torch-npu and triton-ascend pinned to the shared runtime versions.
# Patches are applied after the editable install, never before: a dirty tree changes
# setuptools-scm's recorded version and can select incompatible vllm-ascend paths.
# The recorded version is asserted so any regression fails during the build.
RUN export PIP_EXTRA_INDEX_URL="https://mirrors.huaweicloud.com/ascend/repos/pypi https://download.pytorch.org/whl/cpu https://triton-ascend.osinfra.cn/pypi/simple/" && \
    export PIP_TRUSTED_HOST="mirrors.huaweicloud.com triton-ascend.osinfra.cn download.pytorch.org download-r2.pytorch.org" && \
    export SOC_VERSION=${SOC_VERSION} && \
    export LD_LIBRARY_PATH=${ASCEND_INSTALL_PATH}/cann-${CANN_VERSION}/aarch64-linux/devlib/linux/aarch64:$LD_LIBRARY_PATH && \
    . ${ASCEND_INSTALL_PATH}/ascend-toolkit/set_env.sh && \
    . ${ASCEND_INSTALL_PATH}/nnal/atb/set_env.sh && \
    git clone --depth 1 --branch ${VLLM_TAG} https://github.com/vllm-project/vllm.git /areal-workspace/vllm && \
    git clone --branch ${VLLM_ASCEND_BRANCH} https://github.com/vllm-project/vllm-ascend.git /areal-workspace/vllm-ascend && \
    git -C /areal-workspace/vllm-ascend checkout ${VLLM_ASCEND_COMMIT} && \
    cd /areal-workspace/vllm && \
    VLLM_TARGET_DEVICE=empty pip install -v -e . && \
    git apply -v /areal-workspace/patches/vllm-exact-token-validation.patch && \
    python3 -c "import sys, os; sys.path.insert(0, 'vllm'); import _version; want = os.environ['VLLM_TAG'].removeprefix('v'); assert _version.__version__ == want, f'vllm reports {_version.__version__}, expected {want}'" && \
    pip uninstall -y triton && \
    cd /areal-workspace/vllm-ascend && \
    pip install -r requirements.txt && \
    VLLM_BATCH_INVARIANT=1 COMPILE_CUSTOM_KERNELS=1 pip install --no-build-isolation --no-deps -v -e . && \
    python3 -c "import os; from importlib.metadata import version; from packaging.version import Version; expected = {'torch': '2.10.0', 'torch-npu': '2.10.0.post7', 'triton': '3.6.0', 'triton-ascend': os.environ['TRITON_ASCEND_PACKAGE_VERSION']}; actual = {name: Version(version(name)).public for name in expected}; assert actual == expected, (actual, expected)" && \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 mfcli kernel install --soc-version A3 && \
    python3 -m pip cache purge

# Install the optional AWEX source override.
# Set AWEX_COMMIT="" to use the pyproject.npu.toml package instead.
ARG AWEX_REPO=https://github.com/HwVanICI/asystem-awex.git
ARG AWEX_COMMIT=8b9ad5072e105af0112afa805e8961efc190e515
RUN touch /areal-workspace/awex-manifest.sed && \
    if [ -n "${AWEX_COMMIT}" ]; then \
        git clone "${AWEX_REPO}" /areal-workspace/awex && \
        git -C /areal-workspace/awex checkout "${AWEX_COMMIT}" && \
        python3 -m pip uninstall -y awex-ascend && \
        python3 -m pip install --no-deps --no-build-isolation /areal-workspace/awex && \
        echo '/"awex-ascend==/d' > /areal-workspace/awex-manifest.sed && \
        python3 -m pip cache purge; \
    fi

# ARM64 wheels from the pinned Mooncake and FLA releases.
RUN MOONCAKE_WHL="mooncake_transfer_engine-${MOONCAKE_VERSION}-cp312-cp312-manylinux_2_35_aarch64.whl" && \
    wget --no-check-certificate --no-verbose "${MOONCAKE_OBS_PREFIX}/${MOONCAKE_WHL}" -O "/tmp/${MOONCAKE_WHL}" && \
    echo "1347085176ea15abeaaba02466f22c670f9ce39fd3108b7bee9d3769c0f069bf  /tmp/${MOONCAKE_WHL}" | sha256sum --check && \
    . ${ASCEND_INSTALL_PATH}/ascend-toolkit/set_env.sh && \
    python3 -m pip install aiohttp requests msgpack concurrent-log-handler && \
    python3 -m pip uninstall -y mooncake-transfer-engine-npu && \
    python3 -m pip install --force-reinstall --no-deps "/tmp/${MOONCAKE_WHL}" && \
    rm -f "/tmp/${MOONCAKE_WHL}" && \
    python3 -m pip cache purge

RUN FLA_WHL="flash_linear_attention_npu_a3-${FLA_VERSION}-py3-none-manylinux_2_34_aarch64.whl" && \
    wget --no-check-certificate --no-verbose "https://github.com/flashserve/flash-linear-attention-npu/releases/download/${FLA_RELEASE_TAG}/${FLA_WHL}" -O "/tmp/${FLA_WHL}" && \
    echo "0e0febfe0b524df54c02dead985b787cf51f276ef904e4c2f88c5d43707a370b  /tmp/${FLA_WHL}" | sha256sum --check && \
    python3 -m pip install --force-reinstall --no-deps "/tmp/${FLA_WHL}" && \
    rm -f "/tmp/${FLA_WHL}" && \
    python3 -m pip cache purge

# Install the MCore 0.18 NPU stack in its required MA -> TENPU -> MindSpeed order.
# Expose only megatron/ on PYTHONPATH to avoid examples package collisions.
RUN git clone --branch ${MEGATRON_BRANCH} https://github.com/NVIDIA/Megatron-LM.git /areal-workspace/Megatron-LM && \
    git -C /areal-workspace/Megatron-LM checkout ${MEGATRON_COMMIT} && \
    mkdir -p /areal-workspace/megatron-python && \
    ln -s /areal-workspace/Megatron-LM/megatron /areal-workspace/megatron-python/megatron && \
    git clone --branch ${MEGATRON_ADAPTOR_BRANCH} https://gitcode.com/Ascend/MegatronAdaptor.git /areal-workspace/MegatronAdaptor && \
    git -C /areal-workspace/MegatronAdaptor checkout ${MEGATRON_ADAPTOR_COMMIT} && \
    python3 -m pip install -e /areal-workspace/MegatronAdaptor --no-deps && \
    git clone --branch ${TRANSFORMER_ENGINE_NPU_BRANCH} https://gitcode.com/Ascend/TransformerEngineNPU.git /areal-workspace/TransformerEngineNPU && \
    git -C /areal-workspace/TransformerEngineNPU checkout ${TRANSFORMER_ENGINE_NPU_COMMIT} && \
    python3 -m pip install --no-build-isolation --no-deps -e /areal-workspace/TransformerEngineNPU && \
    git clone --branch ${MINDSPEED_BRANCH} https://gitcode.com/Ascend/MindSpeed.git /areal-workspace/MindSpeed && \
    git -C /areal-workspace/MindSpeed checkout ${MINDSPEED_COMMIT} && \
    python3 -m pip install -e /areal-workspace/MindSpeed --no-deps && \
    python3 -m pip cache purge

# Supply dependencies skipped by source-only/--no-deps training installs:
# qwen-vl-utils/modelopt for Bridge, nvdlfw-inspect for TENPU, tzdata for MindSpeed.
# Restore vLLM 0.30's FastAPI/Starlette requirements after vllm-ascend downgrades them;
# OpenAI >=2.44 is the validated SDK baseline for its Responses API imports.
# Keep this separate so dependency adjustments reuse the backend build layers.
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_HTTP_TIMEOUT=300 uv pip install --system \
        qwen-vl-utils nvidia-modelopt nvdlfw-inspect tzdata \
        'fastapi>=0.133.0,<0.137' 'starlette>=1.0.1' 'openai>=2.44.0'

# Install AReaL application dependencies, preserving the AWEX source override.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.npu.toml,target=pyproject.toml \
    sed -f /areal-workspace/awex-manifest.sed pyproject.toml > /tmp/pyproject.toml && \
    UV_HTTP_TIMEOUT=300 uv pip install -r /tmp/pyproject.toml --system --group dev && \
    rm /tmp/pyproject.toml

# Install Megatron-Bridge
COPY patches/megatron-bridge.v0.5.1-vision-dp-cp.patch /areal-workspace/patches/
RUN git clone --branch ${MEGATRON_BRIDGE_TAG} https://github.com/NVIDIA-NeMo/Megatron-Bridge.git /areal-workspace/Megatron-Bridge && \
    git -C /areal-workspace/Megatron-Bridge checkout ${MEGATRON_BRIDGE_COMMIT} && \
    git -C /areal-workspace/Megatron-Bridge apply -v /areal-workspace/patches/megatron-bridge.v0.5.1-vision-dp-cp.patch && \
    python3 -m pip cache purge

# Copy AReaL source code
COPY . /AReaL
RUN cp /AReaL/pyproject.npu.toml /AReaL/pyproject.toml && \
    uv pip install --no-deps -e /AReaL --system && \
    python3 -c "import importlib.metadata as m, tomllib; expected = tomllib.load(open('/AReaL/pyproject.toml', 'rb'))['project']['version']; actual = m.version('areal'); assert actual == expected, f'areal reports {actual}, expected {expected}'"

ENV PYTHONPATH=/areal-workspace/MegatronAdaptor:/areal-workspace/TransformerEngineNPU:/areal-workspace/MindSpeed:/areal-workspace/megatron-python:/areal-workspace/Megatron-Bridge/src:$PYTHONPATH

# Validate dependency metadata and module paths without importing NPU backends.
RUN python3 -c "import triton; import triton.language; assert callable(triton.jit); assert triton.language.dtype is not None"
RUN python3 -c "import os; from importlib.metadata import version; from packaging.version import Version; expected = {'torch': '2.10.0', 'torch-npu': '2.10.0.post7', 'triton': '3.6.0', 'triton-ascend': os.environ['TRITON_ASCEND_PACKAGE_VERSION'], 'transformers': '5.14.1', 'memfabric-hybrid': '1.3.0', 'memcache-hybrid': '1.3.0'}; actual = {name: Version(version(name)).public for name in expected}; assert actual == expected, (actual, expected)" && \
    python3 -c "import os; from importlib.metadata import version; from packaging.version import Version; expected = {'mooncake-transfer-engine': os.environ['MOONCAKE_VERSION'], 'flash-linear-attention-npu-a3': os.environ['FLA_VERSION']}; actual = {name: version(name) for name in expected}; assert all(Version(actual[name]) == Version(want) for name, want in expected.items()), (actual, expected)" && \
    python3 -c "import os, tomllib; from importlib.metadata import version; from packaging.requirements import Requirement; deps = tomllib.load(open('/AReaL/pyproject.toml', 'rb'))['project']['dependencies']; requirements = [Requirement(dep) for dep in deps]; requirements = [r for r in requirements if not (r.name == 'awex-ascend' and os.environ.get('AWEX_COMMIT'))]; mismatches = [(r.name, version(r.name), str(r.specifier)) for r in requirements if (r.marker is None or r.marker.evaluate()) and r.specifier and not r.specifier.contains(version(r.name))]; assert not mismatches, mismatches" && \
    python3 -c "from importlib.metadata import version; from packaging.requirements import Requirement; requirements = [Requirement(dep) for dep in ('fastapi>=0.133.0,<0.137', 'starlette>=1.0.1', 'openai>=2.44.0')]; mismatches = [(r.name, version(r.name), str(r.specifier)) for r in requirements if not r.specifier.contains(version(r.name))]; assert not mismatches, mismatches" && \
    python3 -c "from importlib.util import find_spec; modules = ('megatron_adaptor', 'transformer_engine', 'mindspeed', 'mbridge', 'megatron.core', 'megatron.training', 'megatron.bridge'); missing = [name for name in modules if find_spec(name) is None]; assert not missing, missing" && \
    python3 -c "from importlib.util import find_spec; spec = find_spec('examples.vlm.geometry3k_grpo'); assert spec is not None and spec.origin == '/AReaL/examples/vlm/geometry3k_grpo.py', spec"

ENV HCCL_IF_BASE_PORT=63000 \
    HCCL_NPU_SOCKET_PORT_RANGE="62100-62350"

ENV TASK_QUEUE_ENABLE=1 \
    OMP_NUM_THREADS=1
