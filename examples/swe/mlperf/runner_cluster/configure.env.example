# Trusted Bash assignments: configure.sh sources this file on the host.
# Copy to configure.env and set the deployment directory and head address.
# Generate once, then start with: bash runner/start.sh --config config/areal-site.yaml
# start.sh CLI options override saved settings; --config and --help are CLI-only.
# Do not pass this file to start.sh --env-file or Docker --env-file.

# areal: per-episode model routing for training; standalone: fixed model endpoint.
# This is the service mode, independent of --role head/worker.
SWE_SERVICE=areal

# Required only for SWE_SERVICE=standalone; ignored in AReaL mode.
# Use an internal model API URL including /v1 and its exact /v1/models ID.
SWE_MODEL_BASE_URL=  # Example: http://MODEL_HOST:MODEL_PORT/v1
SWE_MODEL_NAME=      # Example: MODEL_ID
# For authenticated models, pass MLPERF_MODEL_API_KEY in a separate runtime
# credentials file via SWE_ENV_FILE; no API key is needed to generate YAML.

# Required: absolute host deployment directory; YAML is written under config/.
SWE_DEPLOY_DIR=/path/to/mlperf-runner-deployment
# Required: head IPv4 reachable by every Ray worker (replace HEAD_NODE_IP).
# SWE_ROLE=standalone uses this as the default host bind address, not an inner bind.
SWE_HEAD_IP=HEAD_NODE_IP
# Required except for SWE_ROLE=standalone: Ray head address and port base.
SWE_HEAD_ADDRESS="${SWE_HEAD_IP}:16379"

# Optional defaults; the image must already exist locally.
SWE_RUNNER_IMAGE=mlperf-swe-runner:cluster
SWE_CONFIG_FILE="${SWE_SERVICE}-site.yaml"
SWE_API_PORT=8080       # AReaL bridge or standalone task API; inferred at head launch.
SWE_GYM_PORT=8083       # AReaL only: loopback Gym agent API; ignored in standalone.
SWE_REGISTRY_PORT=8081  # Gym registry, reachable by Ray workers.
SWE_MODEL_PORT=8082     # Model adapter: forwards to AReaL bridge or fixed model URL.
SWE_CONCURRENCY=4      # Active attempts across the whole cluster.
SWE_RAY_WORKER_PORTS=20000-20127
SWE_OBJECT_STORE_MEMORY=1073741824  # Ray object-store bytes per node (1 GiB).

# Optional host launch settings. Select CPU/RAM budgets for each host's capacity;
# these defaults match start.sh, not a measurement of available resources.
SWE_CONTAINER_NAME=mlperf-swe-runner
SWE_CPUS=48           # Whole CPUs for Ray service roles; fractional allowed in preflight.
SWE_MEMORY=400g       # Hard Docker memory limit; includes shared memory below.
SWE_SHM_SIZE=16g
SWE_PREFLIGHT_SIF=    # Relative to SWE_SIF_DIR; empty starts the service.
# Preflight uses no network, service name, or credentials. To override a saved
# preflight at launch, pass --no-preflight; --preflight FILE selects another SIF.
SWE_ROLE=            # Empty infers head when Ray is configured; or head/worker/standalone.
SWE_NODE_IP=         # Head derives its IP; worker requires its own IPv4.
SWE_BIND_ADDRESS=    # Empty uses SWE_HEAD_IP for standalone host port publishing.
SWE_ENV_FILE=        # Optional absolute host runtime credentials path; contents not saved.
SWE_DRY_RUN=false    # true prints the Docker command; --no-dry-run overrides it.
# --env-file '' clears a saved credentials path. Never use this configure.env
# as the runtime credentials file: it contains trusted host Bash assignments.

# Required host launch paths, saved under swe_runner in the generated YAML.
# start.sh reads these automatically; host paths may contain spaces if quoted.
# Both nodes must mount the same shared SIF/results storage; state is node-local.
SWE_SIF_DIR=/path/to/native/sif/images
SWE_RESULTS_DIR=/path/to/shared/swe-results
SWE_STATE_DIR=/path/to/node-local/swe-state

# Optional agent/evaluator settings. These are not Docker CPU/RAM quotas.
SWE_MAX_TURNS=30
SWE_AGENT_TIMEOUT=1800       # Seconds.
SWE_TEST_TIMEOUT=60         # Seconds.
SWE_COMMAND_TIMEOUT=60      # Seconds.
SWE_MEMORY_LIMIT_MB=32768   # Reference memory setting in MiB, not a task cgroup quota.
SWE_CHAT_TEMPLATE_THINKING=disabled  # disabled, enabled, or server-default.

# JSONL remains a task input. Every saved launch setting supports a CLI override.
# Workers reuse this YAML with --role worker --node-ip WORKER_IP. Override
# --state-dir on a worker only when its node-local path needs to differ.
